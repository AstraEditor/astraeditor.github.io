
    const original = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#855cd6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n  <rect x=\"4\" y=\"4\" width=\"16\" height=\"6\" rx=\"1.5\"></rect>\n  <rect x=\"4\" y=\"14\" width=\"9\" height=\"6\" rx=\"1.5\"></rect>\n  <rect x=\"16\" y=\"14\" width=\"4\" height=\"6\" rx=\"1.5\"></rect>\n</svg>\n";

    const getSRC = () => {
        const recolored = typeof Recolor === 'object' ? (
            original.replace(/#855cd6/gi, Recolor.primary)
